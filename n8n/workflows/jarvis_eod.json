    {
      "id": "4e0af68f-e925-5192-be97-cf1aa6e16943",
      "name": "Save tomorrow",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -120,
        0
      ],
      "parameters": {
        "jsCode": "// Write what the Tomorrow's calendar node returned to inbox/tomorrow_calendar.json for the Python side.\nconst fs = require('fs');\nconst items = $('Tomorrow's calendar').all().map(i => i.json);\nconst rows = items.map(m => ({ summary: m.summary, start: m.start?.dateTime || m.start?.date, end: m.end?.dateTime || m.end?.date, location: m.location, attendees: (m.attendees || []).map(a => a.email), description: m.description }));\nfs.mkdirSync('C:/Users/ajwal/Documents/Jarvis-AI/inbox', { recursive: true });\nfs.writeFileSync('C:/Users/ajwal/Documents/Jarvis-AI/inbox/tomorrow_calendar.json', JSON.stringify(rows, null, 1));\nreturn [{ json: { written: 'tomorrow_calendar.json', n: rows.length } }];"
      }
    },
    {
      "id": "4092c572-1f2d-5314-9cf4-3396347cdf2d",
      "name": "Build report (Python)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        100,
        0
      ],
      "parameters": {
        "command": "=cmd /c \"cd /d C:/Users/ajwal/Documents/Jarvis-AI && set PYTHONIOENCODING=utf-8:replace&& python -m jarvis.eod_report\""
      }
    },
    {
