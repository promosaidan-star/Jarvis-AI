      "parameters": {
        "name": "today",
        "description": "Everything about the user's day: weather, calendar, to-dos, tickets, paper portfolio, journal. Input ignored.",
        "language": "javaScript",
        "jsCode": "// Tool: today() -> the same JSON the dashboard reads (weather, calendar, tickets, portfolio, journal).\nconst { execSync } = require('child_process');\nreturn execSync('cmd /c \"cd /d C:/Users/ajwal/Documents/Jarvis-AI && set PYTHONIOENCODING=utf-8:replace&& python -m jarvis.api\"', { maxBuffer: 1 << 24 }).toString();"
      }
    },
    {
      "id": "ce992423-9e9f-5253-adf6-3903a00467f8",
      "name": "log",
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1.3,
      "position": [
        -120,
        840
      ],
      "parameters": {
        "name": "log",
        "description": "Append to the user's journal. Input: 'done|text', 'todo|text' or 'note|text'.",
        "language": "javaScript",
        "jsCode": "// Tool: log(kind|text) -> append to today's journal. kind is done, todo or note.\nconst { execSync } = require('child_process');\nconst [kind, ...rest] = String(query).split('|');\nconst text = rest.join('|').trim().replace(/\"/g, \"'\");\nif (!['done', 'todo', 'note'].includes(kind.trim())) return 'kind must be done, todo or note';\nexecSync('cmd /c \"cd /d C:/Users/ajwal/Documents/Jarvis-AI && python -m jarvis.journal ' + kind.trim() + ' \\\"' + text + '\\\"\"');\nreturn 'logged [' + kind.trim() + '] ' + text;"
      }
    },
