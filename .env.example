# Copy to .env (never committed). Every key is optional: a module whose key is missing
# says "not configured" in the brief instead of failing the whole run.

# LLM for inbox summaries, reply drafts and slide outlines
GEMINI_API_KEY=
JARVIS_LLM_MODEL=gemini-3.5-flash-lite

# Alpaca PAPER account, read-only use (account, positions, portfolio history)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Spotify: create an app at developer.spotify.com, redirect URI http://127.0.0.1:8765/callback,
# then `python -m jarvis.spotify auth` fills in the refresh token.
SPOTIFY_CLIENT_ID=
SPOTIFY_REFRESH_TOKEN=

# Timezone for the journal and briefs
JARVIS_TZ=America/New_York

# Gmail and Google Calendar are connected inside n8n (OAuth credential), not here.
